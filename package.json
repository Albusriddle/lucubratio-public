{
  "name": "lucubratio-pipeline",
  "version": "0.3.22",
  "private": true,
  "description": "Lucubratio 流水线 + 查看器：把任意课程内容编译成可离线学习的内容包（不含任何课程素材）",
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build:debug": "node scripts/gradle.mjs assembleDebug",
    "build:release": "node scripts/gradle.mjs assembleRelease",
    "clean": "node scripts/gradle.mjs clean",
    "test": "node scripts/test.mjs",
    "pack": "node scripts/pack.mjs",
    "test:package": "node scripts/test-package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "test:all": "node scripts/test-all.mjs",
    "verify:device": "node scripts/verify-device.mjs",
    "test:library": "node scripts/test-library.mjs",
    "build:empty": "node scripts/build.mjs --empty",
    "check:pages": "node tools/check-pages.mjs",
    "check:changelog": "node scripts/check-changelog.mjs",
    "check:nav": "node scripts/check-nav.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "license": "Apache-2.0",
  "verifyBaselines": {
    "mermaid": 1,
    "math": 0,
    "sections": 5,
    "totalMB": 30
  },
  "verifyPolicy": {
    "trackedContent": "public"
  }
}
